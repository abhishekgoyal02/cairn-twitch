# Twitch application client ID from the Twitch Developer Console.
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Bootstrap access token generated for the bot account itself. Used once to initialize the local token store.
TWITCH_ACCESS_TOKEN=your_bot_user_access_token
TWITCH_REFRESH_TOKEN=your_bot_refresh_token
TWITCH_ACCESS_TOKEN_EXPIRES_IN=0
TWITCH_TOKEN_OBTAINMENT_TIMESTAMP=0
TWITCH_USER_ID=your_bot_user_id
TWITCH_TOKEN_FILE=.cairn/twitch-token.json

# Login name of the Twitch account represented by TWITCH_ACCESS_TOKEN.
TWITCH_BOT_USERNAME=your_bot_account_name

# Channel to join, without the leading #.
TWITCH_CHANNEL=your_test_channel

# Optional local vault location. Relative paths are resolved from the project root.
CAIRN_VAULT_PATH=cairn-vault

# Optional provider: groq, ollama, or custom. Leave blank for deterministic local behavior.
CAIRN_LLM_PROVIDER=groq
CAIRN_LLM_API_KEY=your_groq_api_key
CAIRN_LLM_MODEL=openai/gpt-oss-20b
# Optional. Used only after an explicitly classified 404/429/5xx outcome,
# within the same eight-second overall deadline. Leave blank to disable model fallback.
CAIRN_LLM_FALLBACK_MODEL=
CAIRN_LLM_ENDPOINT=
